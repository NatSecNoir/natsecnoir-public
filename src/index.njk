---
layout: base.njk
nav: feed
permalink: /
---
<div class="page">
<div class="main">
{% include "filter.njk" %}
<div class="ledger" data-items>
{% for r in feed.all %}{% set isLead = loop.first %}{% include "item.njk" %}{% endfor %}
{% if not feed.all.length %}<p class="empty">No records yet.</p>{% endif %}
</div>
{% if feed.all.length %}<div class="folio sc"><span>{{ feed.all.length }} records</span><a href="/by/list/">Browse by tag</a></div>{% endif %}
</div>
<aside class="rail">
  <section class="letter"><div class="box">
    <div><h2>The Late Edition</h2><p>New records and one short read, when there is something worth knowing. Sent from newsletter.natsecnoir.com.</p></div>
    <form action="{{ site.newsletter }}/subscribe" method="get"><label for="em" class="vh">Email</label><input id="em" name="email" type="email" placeholder="Your address" required><button type="submit">Subscribe</button></form>
  </div></section>
  {% if rail.quote.present %}<section>
    <h2>From the record</h2>
    <p class="quote">{{ rail.quote.text }}</p>
    <p class="src">{% if rail.quote.docket %}<span class="date">{{ rail.quote.docket }}</span>{% endif %}{% if rail.quote.source %} · {{ rail.quote.source }}{% endif %}</p>
  </section>{% endif %}
  {% if rail.tags.length %}<section>
    <h2>Tags</h2>
    <ul class="counts">{% for t in rail.tags %}<li><a href="{{ t.url }}"><b{% if t.label == "Bad Labs" %} class="bad"{% endif %}>{{ t.label }}</b><span class="n">{{ t.count }}</span></a></li>{% endfor %}</ul>
    <a class="more" href="/by/list/">All tags</a>
  </section>{% endif %}
</aside>
</div>
