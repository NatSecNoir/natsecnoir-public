<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ description or site.tagline }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poiret+One&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Libre+Franklin:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head><body>
<header class="mast"><div class="wrap">
  <span class="r"><a href="{{ site.newsletter }}">Newsletter</a><span class="sep">·</span><a href="/feed.xml">RSS</a><span class="sep">·</span><a href="{{ site.about }}">About</a></span>
  <a class="lockup" href="/" aria-label="NatSec Noir — home">
    <svg class="spire" viewBox="0 0 100 100" aria-hidden="true">
      <g fill="currentColor">
        <polygon points="47,22 50,4 53,22"/>
        <rect x="45" y="22" width="10" height="14"/>
        <rect x="41" y="36" width="18" height="16"/>
        <rect x="36" y="52" width="28" height="18"/>
        <rect x="30" y="70" width="40" height="22"/>
        <rect x="16" y="92" width="68" height="3"/>
      </g>
      <g class="cut">
        <rect x="49" y="40" width="2" height="10"/>
        <rect x="43" y="56" width="2" height="12"/><rect x="49" y="56" width="2" height="12"/><rect x="55" y="56" width="2" height="12"/>
        <rect x="37" y="74" width="2" height="16"/><rect x="43" y="74" width="2" height="16"/><rect x="49" y="74" width="2" height="16"/><rect x="55" y="74" width="2" height="16"/><rect x="61" y="74" width="2" height="16"/>
      </g>
    </svg>
    <span class="rule"></span>
    <h1 class="mark">N<small>at</small>S<small>ec</small> N<small>oir</small></h1>
  </a>
  <p class="tag">{{ site.motto }}</p>
</div></header>
<nav class="main" aria-label="Primary">
  <a{% if nav == "feed" %} class="on"{% endif %} href="/">The file</a>
  <a{% if nav == "analysis" and page.url != "/analyses/supply-chain-watch-lists/" %} class="on"{% endif %} href="/analyses/">Analyses</a>
  {%- for slug, l in lists %}
  <a{% if nav == "list" and navSlug == slug %} class="on"{% endif %} href="/by/list/{{ slug }}/">{{ l.label }}</a>
  {%- endfor %}
  <a{% if page.url == "/analyses/supply-chain-watch-lists/" %} class="on"{% endif %} href="/analyses/supply-chain-watch-lists/">Restricted entities</a>
</nav>
<div class="sub">
  <a{% if nav == "list" %} class="on"{% endif %} href="/by/list/">By list</a>
  <a{% if nav == "agency" %} class="on"{% endif %} href="/by/agency/">By source</a>
  {% if records.all.length %}<span class="rt mono">last filed {{ records.all[0].doc_date }}</span>{% endif %}
</div>
<main class="wrap">
{{ content | safe }}
{% if nav != "record" and nav != "feed" %}{# front page renders the newsletter inside its rail (U3); interior pages keep the standalone panel #}
<section class="letter">
  <div class="box">
    <h2>The file, weekly</h2><p>Every record filed that week, with references. Sent from newsletter.natsecnoir.com.</p>
    <form action="{{ site.newsletter }}/subscribe" method="get"><label for="em" class="vh">Email</label><input id="em" name="email" type="email" placeholder="you@firm.com" required><button type="submit">Subscribe</button></form>
  </div>
</section>
{% endif %}
</main>
<footer><div class="wrap">
  <div>
    <div class="fm">N<small>at</small>S<small>ec</small> N<small>oir</small></div>
    <p class="ft">{{ site.motto }}</p>
  </div>
  <div>
    <p>{{ site.tagline }}</p>
    <p>© {{ site.year }} NatSecNoir.com</p>
  </div>
  <div>
    <ul>
      <li><a href="{{ site.newsletter }}">Newsletter</a></li>
      <li><a href="/feed.xml">RSS</a></li>
      <li><a href="{{ site.about }}">About</a></li>
      <li><a href="/analyses/">Analyses</a></li>
    </ul>
    <p class="disc">{{ site.disclaimer }}</p>
  </div>
</div></footer>
</body></html>
