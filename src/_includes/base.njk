<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ description or site.tagline }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Limelight&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
</head><body>
<header class="plate">
  <h1 class="mark" data-text="NatSec Noir"><span class="t"><span class="w1">NatSec</span> <span class="w2">Noir</span></span></h1>
  <p class="tag">Taking public records out of shadowy, smoky bureaucratic backrooms</p>
  <div class="lit" aria-hidden="true"><div class="mark"><span class="w1">NatSec</span> <span class="w2">Noir</span></div></div>
</header>
<div class="strip"><div class="wrap">
  <div class="nav sc">
    <a{% if nav == "feed" %} class="on"{% endif %} href="/">Feed</a>
    <a{% if nav == "list" %} class="on"{% endif %} href="/by/list/">By tags</a>
    <a{% if nav == "agency" %} class="on"{% endif %} href="/by/agency/">By source</a>
    <a{% if nav == "type" %} class="on"{% endif %} href="/by/type/">By type</a>
    <a{% if nav == "analysis" %} class="on"{% endif %} href="/analyses/">Analysis</a>
    <a href="/feed.xml">RSS</a>
  </div>
  {% if feed.all.length %}<div class="dl sc">Updated<span class="date">{{ feed.all[0].doc_date }}</span></div>{% endif %}
</div></div>
<main class="wrap">
{{ content | safe }}
{% if nav != "record" and nav != "feed" %}{# front page renders the newsletter inside its rail (U3); interior by-pages keep the standalone card #}
<section class="letter">
  <div class="box">
    <div><h2>The Late Edition</h2><p>New records and one short read, when there is something worth knowing. Sent from newsletter.natsecnoir.com.</p></div>
    <form action="{{ site.newsletter }}/subscribe" method="get"><label for="em" class="vh">Email</label><input id="em" name="email" type="email" placeholder="Your address" required><button type="submit">Subscribe</button></form>
  </div>
</section>
{% endif %}
</main>
<footer><div class="wrap">
  <div>
    <div class="fm"><span class="w1">NatSec</span> <span class="w2">Noir</span></div>
    <p class="ft">Taking public records out of shadowy, smoky bureaucratic backrooms</p>
  </div>
  <div>
    <h2>Sections</h2>
    <ul class="sc">
      <li><a href="/">Feed</a></li>
      <li><a href="/by/list/">By tags</a></li>
      <li><a href="/by/agency/">By source</a></li>
      <li><a href="/by/type/">By type</a></li>
      <li><a href="/analyses/">Analysis</a></li>
      <li><a href="/feed.xml">RSS</a></li>
    </ul>
  </div>
  <div class="col">
    <h2>Colophon</h2>
    <p>© {{ site.year }} NatSecNoir.com</p>
    <p>Public records. Author's summaries.</p>
    <ul>
      <li><a href="{{ site.repo }}">Repository</a></li>
      <li><a href="{{ site.newsletter }}">Newsletter</a></li>
    </ul>
  </div>
</div></footer>
</body></html>
