<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ description or site.tagline }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Marcellus+SC&family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script>
  /* Apply a stored theme before first paint to avoid a flash of the wrong palette. Light is the
     default: only an explicit stored choice switches to dark; OS preference is not followed. */
  try { var t = localStorage.getItem('theme');
    if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
</script>
<link rel="stylesheet" href="/css/site.css">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script src="/js/theme.js" defer></script>
</head><body>
<header class="mast"><div class="wrap">
  <a class="lockup" href="/" aria-label="NatSec Noir — home">
    <svg class="spire" viewBox="0 0 100 100" aria-hidden="true">
      <g fill="currentColor">
        <polygon points="47,22 50,4 53,22"/>
        <rect x="45" y="22" width="10" height="14"/>
        <rect x="41" y="36" width="18" height="16"/>
        <rect x="36" y="52" width="28" height="18"/>
        <rect x="30" y="70" width="40" height="22"/>
        <rect x="16" y="92" width="68" height="3"/>
      </g>
      <g class="cut">
        <rect x="49" y="40" width="2" height="10"/>
        <rect x="43" y="56" width="2" height="12"/><rect x="49" y="56" width="2" height="12"/><rect x="55" y="56" width="2" height="12"/>
        <rect x="37" y="74" width="2" height="16"/><rect x="43" y="74" width="2" height="16"/><rect x="49" y="74" width="2" height="16"/><rect x="55" y="74" width="2" height="16"/><rect x="61" y="74" width="2" height="16"/>
      </g>
    </svg>
    <span class="rule"></span>
    <h1 class="mark">N<small>at</small>S<small>ec</small> N<small>oir</small></h1>
  </a>
  <p class="tag">{{ site.motto }}</p>
  <span class="r"><a href="{{ site.newsletter }}">Newsletter</a><span class="sep">·</span><a href="/feed.xml">RSS</a><span class="sep">·</span><a href="{{ site.about }}">About</a></span>
</div></header>
<nav class="main" aria-label="Primary">
  <span class="tabs">
    <a{% if nav == "feed" %} class="on"{% endif %} href="/">The File</a>
    <a{% if nav == "analysis" %} class="on"{% endif %} href="/analyses/">Analyses</a>
    <a{% if nav == "list" and navSlug == "covered-list" %} class="on"{% endif %} href="/by/list/covered-list/">Covered List</a>
    <a{% if nav == "list" and navSlug == "bad-labs" %} class="on"{% endif %} href="/by/list/bad-labs/">Bad Labs</a>
  </span>
  <span class="navx">
    <span class="rcount mono">{{ records.all.length }} records</span>
    <button id="theme" type="button" aria-label="Switch to dark theme" title="Toggle light / dark">
      <svg class="icon-sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19.1v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" hidden><path d="M20 14.2A8 8 0 0 1 9.8 4 7 7 0 1 0 20 14.2z"/></svg>
      <span id="theme-label">Dark</span>
    </button>
  </span>
</nav>
<main class="wrap">
{{ content | safe }}
{% if nav != "record" and nav != "feed" %}{# front page renders the newsletter inside its rail (U3); interior pages keep the standalone panel #}
<section class="letter">
  <div class="box">
    <h2>The file, weekly</h2><p>Every record filed that week, with references. Sent from newsletter.natsecnoir.com.</p>
    <form action="{{ site.newsletter }}/subscribe" method="get"><label for="em" class="vh">Email</label><input id="em" name="email" type="email" placeholder="you@firm.com" required><button type="submit">Subscribe</button></form>
  </div>
</section>
{% endif %}
</main>
<footer><div class="wrap">
  <div>
    <div class="fm">N<small>at</small>S<small>ec</small> N<small>oir</small></div>
    <p class="ft">{{ site.motto }}</p>
  </div>
  <div>
    <p>{{ site.tagline }}</p>
    <p>© {{ site.year }} NatSecNoir.com</p>
  </div>
  <div>
    <ul>
      <li><a href="{{ site.newsletter }}">Newsletter</a></li>
      <li><a href="/feed.xml">RSS</a></li>
      <li><a href="{{ site.about }}">About</a></li>
      <li><a href="/analyses/">Analyses</a></li>
      {%- for slug, l in lists %}
      <li><a href="/by/list/{{ slug }}/">{{ l.label }}</a></li>
      {%- endfor %}
      <li><a href="/by/agency/">By source</a></li>
    </ul>
    <p class="disc">{{ site.disclaimer }}</p>
  </div>
</div></footer>
</body></html>
