<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ description or site.tagline }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poiret+One&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
</head><body>
<header class="plate">
  <h1 class="mark"><a href="/" aria-label="{{ site.name }}"><span class="w1">NatSec</span> <span class="w2">Noir</span></a></h1>
  <p class="tag">Taking public records out of dark, smoky government backrooms</p>
</header>
<div class="strip"><div class="wrap">
  <div class="nav sc">
    <a{% if nav == "feed" %} class="on"{% endif %} href="/">Feed</a>
    <a{% if nav == "list" %} class="on"{% endif %} href="/by/list/">By tags</a>
    <a{% if nav == "agency" %} class="on"{% endif %} href="/by/agency/">By source</a>
    <a{% if nav == "type" %} class="on"{% endif %} href="/by/type/">By type</a>
    <a href="/feed.xml">RSS</a>
  </div>
  {% if feed.all.length %}<div class="dl sc">Updated<span class="date">{{ feed.all[0].doc_date }}</span></div>{% endif %}
</div></div>
<main class="wrap">
{{ content | safe }}
{% if nav != "record" %}
<section class="letter">
  <div class="box">
    <div><h2>The Late Edition</h2><p>New records and one short read, when there is something worth knowing. Sent from newsletter.natsecnoir.com.</p></div>
    <form action="{{ site.newsletter }}/subscribe" method="get"><label for="em" class="vh">Email</label><input id="em" name="email" type="email" placeholder="Your address" required><button type="submit">Subscribe</button></form>
  </div>
</section>
{% endif %}
</main>
<footer><div class="wrap sc"><span>© {{ site.year }} NatSecNoir.com</span><span>Public records · Author's summaries · <a href="{{ site.repo }}">Repository</a></span></div></footer>
</body></html>
