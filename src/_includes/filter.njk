<form class="filter" data-filter role="search" aria-label="Filter records by keyword" onsubmit="return false">
  <input type="search" name="q" placeholder="Filter by title, agency, list, entity, docket…" autocomplete="off" spellcheck="false" aria-label="Keyword">
  <button type="button" data-clear>Clear</button>
  <span class="count" data-count aria-live="polite"></span>
</form>
<script src="/js/filter.js" defer></script>
