<article class="item{% if isLead %} lead{% endif %}{% if r.kind == "analysis" %} analysis{% endif %}" data-date="{{ r.doc_date }}" data-search="{{ r.search }}">
  {% if r.kind == "analysis" %}
  <div class="slug sc"><span class="type">Analysis</span>{% if r.baseline_source or r.baseline %}<span class="sep">·</span><span class="tag">{{ r.baseline_source or r.baseline }}</span>{% endif %}</div>
  <div class="ref"><span class="date">{{ r.doc_date }}</span><span class="docket">{{ r.entries.length }} entries</span></div>
  {% else %}
  <div class="slug sc"><span class="type">{{ r.doc_type }}</span>{% for l in r.lists %}<span class="sep">·</span><span class="{% if l.label == "Bad Labs" %}bad{% else %}tag{% endif %}">{{ l.label }}</span>{% endfor %}</div>
  <div class="ref"><span class="date">{{ r.doc_date }}</span>{% if r.docket %}<span class="docket">{{ r.docket.split(";")[0] }}</span>{% endif %}</div>
  {% endif %}
  <h3><a href="{{ r.url }}">{{ r.title }}</a></h3>
  <p>{{ r.excerpt }}</p>
</article>
