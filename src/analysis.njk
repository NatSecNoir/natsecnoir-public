---
layout: base.njk
nav: analysis
pagination:
  data: analyses.all
  size: 1
  alias: a
permalink: "{{ a.url }}"
eleventyComputed:
  title: "{{ a.title }}"
  description: "{{ a.excerpt }}"
---
<div class="rec">
<article class="record analysis">
  <div class="crumb"><a href="/">The file</a> › <a href="/analyses/">Analyses</a></div>
  <span class="k cat">Analysis{% if a.baseline_source or a.baseline %} · {{ a.baseline_source or a.baseline }}{% endif %}</span>
  <h1>{{ a.title }}</h1>
  {% if a.excerpt %}<p class="stand">{{ a.excerpt }}</p>{% endif %}
  <dl class="meta">
    {% if a.baseline_source or a.baseline %}<dt>Baseline</dt><dd>{{ a.baseline_source or a.baseline }}</dd>{% endif %}
    <dt>Entries</dt><dd class="mono">{{ a.entries.length }}</dd>
    <dt>Currency checked</dt><dd class="mono">{{ a.currency_date or "—" }}</dd>
    {% if a.published_at %}<dt>Entered</dt><dd class="mono">{{ a.published_at.slice(0, 10) }}</dd>{% endif %}
  </dl>
  <div class="summary">
  {% for e in a.entries %}
    <h3>{{ e.label }}</h3>
    <p>{{ e.text }}</p>
    {% if e.date or e.cites.length %}
    <p class="prov"><i>{% if e.date %}Added {{ e.date }}{% if e.updates.length %}; updated {{ e.updates | join(", ") }}{% endif %}.{% endif %}{% if e.cites.length %} Sources: {% for c in e.cites %}{% set s = a.sources[c.src] %}{% if s and s.url %}<a href="{{ s.url }}{% if c.page %}#page={{ c.page }}{% endif %}">{{ c.label or c.src }}</a>{% else %}{{ c.label or c.src }}{% endif %}{% if c.note %} ({{ c.note }}){% endif %}{% if not loop.last %} · {% endif %}{% endfor %}.{% endif %}</i></p>
    {% endif %}
  {% else %}
    <p class="empty">No entries yet.</p>
  {% endfor %}
  </div>
  {% if a.archive.length %}
  <div class="ents"><span class="k lbl">Change log</span>
    <ul class="archivelog mono">
    {% for e in a.archive | reverse %}
      <li>{{ e.at.slice(0, 10) }} · {{ e.decision }} · {{ e.label or e.key }}</li>
    {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if a.footnotes.length %}
  <ul class="footnotes">
    {% for f in a.footnotes %}<li>{{ f }}</li>{% endfor %}
  </ul>
  {% endif %}
  <div class="methodology">
    <p>Rendered from the mesh. Architecture after Raymond Sun, <a href="https://www.techieray.com/LiveAndBreathingEssay">The Live and Breathing Essay</a> (CC BY 4.0). Look after <a href="https://natsecnoir.com">NatSecNoir</a>.</p>
  </div>
</article>
<aside class="rail">
  <section class="src">
    <h2>Source</h2>
    <ul><li><a href="/analyses/{{ a.id }}/mesh.json">mesh.json</a></li></ul>
    <p>Every entry cites its source document by page.</p>
  </section>
  <section class="citebox">
    <h2>Cite this analysis</h2>
    <pre class="cite">NatSec Noir, "{{ a.title }}", {{ a.doc_date }}, {{ site.url }}{{ a.url }}</pre>
    <button type="button" class="k" data-copy hidden>Copy citation</button><span class="vh" data-copied aria-live="polite"></span>
  </section>
</aside>
</div>
<script src="/js/cite.js" defer></script>
