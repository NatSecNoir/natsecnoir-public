{"version": 1, "layout": "spans", "parts": {"order": "Order", "statement-brendan-carr": "Statement of Brendan Carr"}, "outline": [{"id": "h1", "level": 1, "label": "I. INTRODUCTION", "title": "I. INTRODUCTION", "page": 1}, {"id": "h2", "level": 2, "label": "A. Modular Transmitters", "title": "A. Modular Transmitters", "page": 2}], "blocks": [{"id": "b1", "kind": "block", "page": 1, "part": "synopsis", "section": "", "number": null, "text": "Before the Federal Communications Commission", "footnotes": [], "markers": []}, {"id": "h1", "kind": "heading", "page": 1, "part": "order", "section": "", "number": null, "text": "I. INTRODUCTION", "footnotes": [], "markers": []}, {"id": "p1", "kind": "para", "page": 1, "part": "order", "section": "I", "number": 1, "text": "We adopt rules for <covered> equipment (EA Security R&O).1  We also act today.2", "footnotes": [{"n": 1, "text": "1 Protecting Against National Security Threats, 37 FCC Rcd 13493 (2022).", "page": 1}, {"n": 2, "text": "2 See id.", "page": 1}], "markers": [1, 2]}, {"id": "h2", "kind": "heading", "page": 2, "part": "order", "section": "", "number": null, "text": "A. Modular Transmitters", "footnotes": [], "markers": []}, {"id": "p2", "kind": "para", "page": 2, "part": "order", "section": "A", "number": 2, "text": "Any modular transmitter (as defined in section 15.2123) is covered.", "footnotes": [{"n": 3, "text": "3 47 CFR 15.212.", "page": 2}], "markers": [3]}, {"id": "b9", "kind": "block", "page": 2, "part": "statement-brendan-carr", "section": "", "number": null, "text": "Today we protect our networks.4", "footnotes": [{"n": 4, "text": "4 A note in the statement.", "page": 2}], "markers": [4]}]}